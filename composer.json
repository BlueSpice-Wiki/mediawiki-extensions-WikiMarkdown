{
	"name": "mediawiki/wikimarkdown",
	"description": "Markdown syntax for MediaWiki",
	"extra": {
		"installer-name": "WikiMarkdown"
	},
	"require": {
		"php": ">=8.1",
		"erusev/parsedown": "^1.8.0",
		"composer/installers": "~1.0|~2"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Nathan Kuenzig"
		}
	],
	"suggest": {
		"erusev/parsedown-extra": "Optional extra package",
		"benjaminhoegh/parsedown-extended": "Optional extra package"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"phpcs -p -s",
			"minus-x check ."
		]
	}
}
