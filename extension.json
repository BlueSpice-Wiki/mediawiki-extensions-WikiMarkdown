{
	"name": "WikiMarkdown",
	"version": "1.2.0-mw1.47",
	"author": [
		"Nathan Kuenzig"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:WikiMarkdown",
	"descriptionmsg": "wikimarkdown-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.44.0",
		"platform": {
			"php": ">= 8.1"
		}
	},
	"MessagesDirs": {
		"WikiMarkdown": [
			"i18n"
		]
	},
	"AutoloadClasses": {
		"WikiMarkdown": "includes/WikiMarkdown.php",
		"WikiMarkdownParsoidTag": "includes/WikiMarkdownParsoidTag.php"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "WikiMarkdown/modules"
	},
	"Hooks": {
		"ParserFirstCallInit": "WikiMarkdown::onParserFirstCallInit",
		"ResourceLoaderRegisterModules": "WikiMarkdown::onResourceLoaderRegisterModules"
	},
	"ParsoidModules": [
		{
			"name": "WikiMarkdown",
			"tags": [
				{
					"name": "markdown",
					"handler": "WikiMarkdownParsoidTag",
					"options": {
						"html2wt": {
							"format": "block"
						}
					}
				}
			]
		}
	],
	"attributes": {
		"VisualEditor": {
			"PluginModules": [
				"ext.wikimarkdown.visualEditor"
			]
		}
	},
	"config": {
		"AllowMarkdownExtra": {
			"value": false
		},
		"AllowMarkdownExtended": {
			"value": false
		},
		"ParsedownExtendedParameters": {
			"value": {
				"math": {
					"single_dollar": true
				},
				"sup": true,
				"sub": true
			}
		}
	},
	"TrackingCategories": [
		"markdown-error-category"
	],
	"manifest_version": 2
}
